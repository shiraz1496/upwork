generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  bidder
}

enum MemberStatus {
  active
  inactive
}

enum CoverageEntityType {
  offer
  message_thread
  proposal
}

// --- MCP migration additions ---

// Lifecycle of a developer's own Upwork MCP OAuth connection.
enum ConnectionStatus {
  disconnected
  connected
  expired
  revoked
  error
}

// New proposal-tracking state machine. A developer confirmation is
// self-reported (SUBMISSION_UNVERIFIED) until/unless an official MCP tool
// can independently verify it (SUBMITTED_CONFIRMED).
enum ProposalState {
  DRAFT
  READY
  SUBMISSION_UNVERIFIED
  SUBMITTED_CONFIRMED
}

// Where a given record came from — never conflate these in the UI.
enum Provenance {
  MCP_VERIFIED       // returned by an official MCP tool
  APP_RECORDED       // generated by an action inside our app
  DEVELOPER_CONFIRMED // self-reported by the developer, not independently verified
}

model TeamMember {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  role      Role         @default(bidder)
  status    MemberStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Application authentication (replaces admin shared-password + extension-token login).
  passwordHash   String?   // scrypt: salt:hash (hex). Null until invited/set.
  passwordSetAt  DateTime?
  lastLoginAt    DateTime?
  sessionVersion Int       @default(0) // bump to invalidate all server-side sessions

  tokens            ExtensionToken[]
  coverageItems     CoverageItem[]
  notesAuthored     CoachingNote[]   @relation("NoteAuthor")
  notesReceived     CoachingNote[]   @relation("NoteRecipient")
  capturedProposals   Proposal[] @relation("ProposalCapturedBy")
  submittedProposals  Proposal[] @relation("ProposalSubmittedBy")
  capturedAlerts    Alert[]
  pageVisits        PageVisit[]
  visitLogs         VisitLog[]
  capturedProfiles  FreelancerProfile[]
  nudgesReceived    Nudge[] @relation("NudgeBidder")
  nudgesCreated     Nudge[] @relation("NudgeCreatedBy")

  // MCP migration relations
  upworkConnection  UpworkConnection?
  proposalDrafts    ProposalDraft[]
  proposalEvents    ProposalStatusEvent[]
  clientResponses   ClientResponse[]
  jobReviews        JobReviewLog[]
}

// One per developer. Holds that developer's own Upwork OAuth tokens (encrypted
// at rest). Tokens are NEVER shared across members; access is always scoped by
// memberId + authorization checks. See lib/upwork/connection.ts.
model UpworkConnection {
  id             String           @id @default(cuid())
  memberId       String           @unique
  member         TeamMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status         ConnectionStatus @default(disconnected)

  upworkAccountId String?         // provider account identity (ciphertext id)
  accountName     String?
  scopes          String[]

  // Encrypted with APP_ENCRYPTION_KEY (AES-256-GCM). Never logged, never sent to the client.
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  // Short-lived OAuth-flow state (PKCE). Cleared after callback.
  oauthState        String?
  oauthCodeVerifier String?

  connectedAt  DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// Developer-authored proposal record for the forward-only workflow.
// Distinguishes developer-authored content (coverLetter) from MCP-derived job
// data (jobDescriptionCache) so retention rules can differ per category.
model ProposalDraft {
  id        String     @id @default(cuid())
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account?   @relation(fields: [accountId], references: [id])

  // Job reference (MCP-derived identifiers + URL).
  upworkJobId          String
  jobUrl               String
  jobTitle             String
  jobDescriptionCache  String?    @db.Text // MCP-derived; subject to retention (expiresAt)
  jobDataProvenance    Provenance @default(MCP_VERIFIED)
  jobDataExpiresAt     DateTime?

  // Developer-authored content (APP_RECORDED / DEVELOPER_CONFIRMED; retained per policy).
  coverLetter      String        @db.Text
  bidType          String        @default("hourly") // "hourly" | "fixed"
  proposedRate     String?
  fixedBidAmount   String?

  state            ProposalState @default(DRAFT)

  readyAt                 DateTime?
  submissionConfirmedAt   DateTime?
  submittedCoverLetter    String?   @db.Text // snapshot taken at confirmation
  submittedBidAmount      String?
  submissionProvenance    Provenance? // DEVELOPER_CONFIRMED unless MCP-verified

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents ProposalStatusEvent[]
  responses    ClientResponse[]

  @@index([memberId, state])
  @@index([upworkJobId])
}

// Append-only audit trail of proposal state transitions.
model ProposalStatusEvent {
  id        String        @id @default(cuid())
  draftId   String
  draft     ProposalDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  actorId   String
  actor     TeamMember    @relation(fields: [actorId], references: [id])
  fromState ProposalState?
  toState   ProposalState
  note      String?
  at        DateTime      @default(now())

  @@index([draftId])
}

// Client responses/messages retrieved via MCP, optionally associated to a draft.
// Association is by VERIFIED identifier when possible, otherwise manual.
model ClientResponse {
  id                String        @id @default(cuid())
  memberId          String
  member            TeamMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  draftId           String?
  draft             ProposalDraft? @relation(fields: [draftId], references: [id])

  upworkThreadId    String?
  upworkMessageId   String?
  kind              String        @default("message") // message | interview | offer | contract
  snippet           String?       @db.Text // MCP-derived; subject to retention (expiresAt)
  receivedAt        DateTime?
  provenance        Provenance    @default(MCP_VERIFIED)
  associationMethod String        @default("verified_identifier") // verified_identifier | manual
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())

  @@index([memberId])
  @@index([draftId])
}

// "Jobs reviewed inside the dashboard" — an app-recorded activity metric that
// replaces the removed browser-surveillance signal. NOT Upwork browsing data.
model JobReviewLog {
  id         String     @id @default(cuid())
  memberId   String
  member     TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  upworkJobId String
  jobTitle   String?
  reviewedAt DateTime   @default(now())
  source     Provenance @default(APP_RECORDED)

  @@index([memberId, reviewedAt])
}

model AccountKeyword {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([accountId])
}

model ExtensionToken {
  id         String     @id @default(cuid())
  memberId   String
  member     TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String     @unique
  label      String?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([memberId])
}

model CoverageItem {
  id           String             @id @default(cuid())
  memberId     String
  member       TeamMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account            @relation(fields: [accountId], references: [id])
  entityType   CoverageEntityType
  entityId     String
  openUrl      String?
  reasonTags   String[]
  referencedAt DateTime           @default(now())
  capturedAt   DateTime?
  priority     Int                @default(0)

  @@unique([memberId, accountId, entityType, entityId])
  @@index([memberId, capturedAt])
}

model CoachingNote {
  id          String     @id @default(cuid())
  authorId    String
  author      TeamMember @relation("NoteAuthor", fields: [authorId], references: [id])
  recipientId String
  recipient   TeamMember @relation("NoteRecipient", fields: [recipientId], references: [id])
  proposalId  String?
  proposal    Proposal?  @relation(fields: [proposalId], references: [id])
  body        String     @db.Text
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([recipientId, readAt])
  @@index([proposalId])
}


model Account {
  id              String         @id @default(cuid())
  freelancerId    String         @unique
  name            String
  jss             Float?
  connectsBalance Int?
  isDisabled      Boolean        @default(false)
  disabledReason  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  proposals       Proposal[]
  alerts          Alert[]
  coverageItems   CoverageItem[]
  pageVisits      PageVisit[]
  visitLogs       VisitLog[]
  profile         FreelancerProfile?
  keywords        AccountKeyword[]
  proposalDrafts  ProposalDraft[]
}

model FreelancerProfile {
  id                  String   @id @default(cuid())
  accountId           String   @unique
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title               String?
  photoUrl            String?
  location            String?
  hourlyRate          String?
  totalEarnings       String?
  totalJobs           Int?
  totalHours          Int?
  overview            String?  @db.Text
  skills              String[]
  capturedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
  capturedByUserId    String?
  capturedByUser      TeamMember? @relation(fields: [capturedByUserId], references: [id])

  @@index([capturedByUserId])
}

model Alert {
  id                String    @id @default(cuid())
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id])
  type              String
  title             String
  senderName        String?
  preview           String?
  url               String?
  roomId            String?
  jobTitle          String?
  date              String?
  freelancerReplied Boolean   @default(false)
  lastMessageSender String?
  lastMessageText   String?
  lastMessageTime   String?
  needsAttention    Boolean   @default(false)
  isUnread          Boolean   @default(false)
  read              Boolean   @default(false)
  replied           Boolean   @default(false)
  notifiedAt        DateTime  @default(now())
  remindedAt        DateTime?
  createdAt         DateTime  @default(now())

  capturedByUserId String?
  capturedByUser   TeamMember? @relation(fields: [capturedByUserId], references: [id])
  capturedAt       DateTime?

  @@index([accountId])
  @@index([type])
  @@index([roomId])
  @@index([capturedByUserId])
}

model Proposal {
  id                    String    @id @default(cuid())
  accountId             String
  account               Account   @relation(fields: [accountId], references: [id])
  jobTitle              String?
  jobUrl                String?
  jobCategory           String?
  status                String?
  section               String?
  boosted               Boolean   @default(false)
  boostStatus           String?
  viewedByClient        Boolean   @default(false)
  coverLetter           String?   @db.Text
  clientNote            String?   @db.Text
  clientName            String?
  clientCountry         String?
  connectsSpent         Int?
  submittedAt           DateTime?
  submittedViaExtension Boolean   @default(false)
  profileUsed           String?
  proposedRate          String?
  receivedRate          String?
  rateIncrease          String?
  bidConnects           Int?
  jobBudget             String?
  jobHoursPerWeek       String?
  jobDuration           String?
  jobExperienceLevel    String?
  jobDescription        String?   @db.Text
  jobSkills             String[]
  jobPostedDate         String?
  clientRating          Float?
  clientReviews         Int?
  clientReviewScore     String?
  clientCity            String?
  clientJobsPosted      Int?
  clientHireRate        Int?
  clientOpenJobs        Int?
  clientTotalSpent      String?
  clientHires           Int?
  clientActiveHires     Int?
  clientAvgRate         String?
  clientTotalHours      String?
  clientMemberSince     String?
  clientPaymentVerified Boolean   @default(false)
  clientCompany         String?
  hiredAt               DateTime?
  contractEndedAt       DateTime?
  contractStatus        String?
  contractRating        Float?
  contractBudget        String?
  contractRate          String?
  contractWeeklyLimit   String?
  createdAt             DateTime  @default(now())

  capturedByUserId   String?
  capturedByUser     TeamMember? @relation("ProposalCapturedBy", fields: [capturedByUserId], references: [id])
  capturedAt         DateTime?
  submittedByUserId  String?
  submittedByUser    TeamMember? @relation("ProposalSubmittedBy", fields: [submittedByUserId], references: [id])

  coachingNotes CoachingNote[]
  nudges        Nudge[]

  @@index([accountId])
  @@index([capturedByUserId])
  @@index([submittedByUserId])
}

model Nudge {
  id          String     @id @default(cuid())
  bidderId    String
  bidder      TeamMember @relation("NudgeBidder", fields: [bidderId], references: [id])
  proposalId  String
  proposal    Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   TeamMember @relation("NudgeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  deliveredAt DateTime?

  @@index([bidderId, deliveredAt])
  @@index([proposalId])
}

model BiddingCriterion {
  id        String   @id @default(cuid())
  key       String   // e.g. "client_total_spent", "client_rating"
  operator  String   @default("gte") // "gte", "lte", "eq"
  value     String   // threshold value e.g. "1000"
  required  Boolean  @default(true)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequiredPage {
  id            String      @id @default(cuid())
  name          String
  url           String
  cooldownHours Int         @default(1)
  createdAt     DateTime    @default(now())
  visits        PageVisit[]
  visitLogs     VisitLog[]
}

model PageVisit {
  id        String       @id @default(cuid())
  pageId    String
  page      RequiredPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account?     @relation(fields: [accountId], references: [id])
  visitedAt DateTime     @default(now())

  @@unique([pageId, memberId, accountId])
  @@index([memberId])
  @@index([pageId])
  @@index([memberId, accountId])
}

model VisitLog {
  id        String       @id @default(cuid())
  pageId    String
  page      RequiredPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account?     @relation(fields: [accountId], references: [id])
  coveredAt DateTime     @default(now())

  // Each row = one coverage event (bidder visited page while it was uncovered)
  @@index([memberId, coveredAt])
  @@index([coveredAt])
}

// Strings the extension and sync endpoints must NOT treat as a job title.
// Managed dynamically from the admin UI; replaces the hardcoded BAD_TITLES
// arrays in extension/src/content.js + app/api/sync/{proposals,contracts}.
model BlockedTitle {
  id        String   @id @default(cuid())
  pattern   String   @unique
  scope     String   @default("all") // "all" | "proposals" | "contracts"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, scope])
}
