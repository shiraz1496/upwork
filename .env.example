# Upwork Tracker — environment variables
# Copy to `.env` (shared/hosted values) or `.env.local` (your machine; overrides `.env` for
# `next dev`). NEVER commit real values. This file holds placeholders only.

# ── Database (Postgres) ───────────────────────────────────────────────────────────────────
# DATABASE_URL is what the app uses. DIRECT_URL is used by a few maintenance scripts.
# Local development: a Docker Postgres, e.g.
#   docker run -d --name upwork-pg -e POSTGRES_USER=upwork -e POSTGRES_PASSWORD=upwork \
#     -e POSTGRES_DB=upwork -p 5433:5432 postgres:16
DATABASE_URL="postgresql://upwork:upwork@localhost:5433/upwork"
DIRECT_URL="postgresql://upwork:upwork@localhost:5433/upwork"

# ── Application login ─────────────────────────────────────────────────────────────────────
# Two DIFFERENT secrets (each at least 16 characters) sign the admin and the bidder session
# cookies. Generate each with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=""
DEV_SESSION_SECRET=""

# Encrypts Upwork OAuth tokens at rest (AES-256-GCM). Must be 32 bytes, base64.
# Generate with:  openssl rand -base64 32
# Changing it makes stored Upwork connections unreadable (bidders would reconnect).
APP_ENCRYPTION_KEY=""

# The app's public address. Used for the CORS allow-list and the OAuth redirect.
# Production: https://upwork-tracking-tool.vercel.app
APP_BASE_URL="http://localhost:3000"

# ── Upwork MCP integration ────────────────────────────────────────────────────────────────
# Master switch. Keep "false" until Upwork has approved this app (hosted client, storing
# MCP output). When false, every Upwork feature answers "disabled" and nothing is fetched.
UPWORK_MCP_ENABLED="false"

# Reserved for scheduled (background) syncing. Nothing in the app schedules anything today;
# keep "false" until Upwork approves scheduled activity.
UPWORK_SYNC_SCHEDULE_ENABLED="false"

UPWORK_MCP_URL="https://mcp.upwork.com/mcp"

# OAuth client for this app. Get the client id once per environment with:
#   node scripts/register-upwork-client.mjs --redirect-uri <APP_BASE_URL>/api/me/upwork/callback
# The secret is only needed if Upwork issues one (public clients with PKCE have none).
UPWORK_OAUTH_CLIENT_ID=""
UPWORK_OAUTH_CLIENT_SECRET=""
UPWORK_OAUTH_REDIRECT_URI="http://localhost:3000/api/me/upwork/callback"

# Local development only: use built-in made-up Upwork data so the screens can be exercised
# without Upwork. Ignored when NODE_ENV=production. Data is labelled "Test data".
UPWORK_MCP_MOCK="false"

# ── AI scoring (Gemini) ───────────────────────────────────────────────────────────────────
# Off by default: AI scoring may need Upwork's approval and is not part of the required flow.
AI_SCORING_ENABLED="false"
GEMINI_API_KEY=""

# ── No longer used (safe to remove from existing environments) ────────────────────────────
# ADMIN_PASSWORD        — replaced by per-person email + password login
# TOKEN_HASH_PEPPER     — only used by the retired extension tokens
